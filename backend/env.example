# 台股：FinMind（日線 TaiwanStockPrice；本益比/淨值比 TaiwanStockPER 同表；EPS 由 TaiwanStockFinancialStatements；股名 TaiwanStockInfo）
# https://api.finmindtrade.com
FINMIND_API_TOKEN=
# FinMind HTTP：程序內 TTLCache（秒）。K 線與基本面 v4 /data 分開設定。
FINMIND_KLINE_CACHE_TTL=120
FINMIND_FUNDAMENTAL_CACHE_TTL=60
# get_cached_stock_data 整包（台股日線／美股 Yahoo）記憶體快取
STOCK_DATA_CACHE_TTL_SECONDS=60
# 台股證交所 MIS 即時報價
TW_MIS_CACHE_TTL_SECONDS=30

# TWSE OpenAPI：預設關閉；僅備援用，設為 true 才會發 HTTP
ENABLE_TWSE_OPENAPI=false

# 台股基本面：stock_fundamentals 表快取；TTL 內不重打 FinMind（小時）
FUNDAMENTAL_TTL_HOURS=24
# 每日背景同步（true/false）
ENABLE_FUNDAMENTAL_DAILY_SYNC=true
# 每日同步最多檔數
FUNDAMENTAL_DAILY_SYNC_MAX=500

# 行情快取：price_cache / chart_cache TTL（分鐘）；scanner_cache 自選股命中時亦用 SCANNER_CACHE_TTL_MINUTES
MARKET_PRICE_TTL_MINUTES=10
MARKET_CHART_TTL_MINUTES=10
# 程序內熱快取（秒）：同一標的在 quote/detail/chart/signal 短時間內共用，減少重複讀 DB
MARKET_HOT_CACHE_SECONDS=45

# PostgreSQL 專用：連線池（併發多時避免卡「等連線」；SQLite 不適用）
# DB_POOL_SIZE=8
# DB_MAX_OVERFLOW=16
# DB_POOL_RECYCLE=1800

# 加密：預設 Binance 主來源；設 CRYPTO_ENABLE_BYBIT_FALLBACK=false 可完全停用 Bybit
CRYPTO_QUOTE_PRIMARY=binance
CRYPTO_KLINE_PRIMARY=binance
CRYPTO_TICKERS_PRIMARY=binance
CRYPTO_ENABLE_BYBIT_FALLBACK=true
# 背景掃描中的 CRYPTO 輪詢：預設關閉（Render 常見 Binance 451 / Bybit 403，避免每 10 分鐘打爆）
# 主機可連交易所時改為 true
ENABLE_CRYPTO_BACKGROUND_SCAN=false
# 兩所任一回 403/451 後，全程序冷卻秒數（circuit breaker）
CRYPTO_PROVIDER_OUTAGE_SECONDS=1200
# 相同錯誤類別日誌節流間隔（秒）
CRYPTO_ERROR_LOG_INTERVAL_SECONDS=300
# 加密掃描執行緒上限（背景任務用，降低突發併發）
CRYPTO_SCAN_MAX_WORKERS=2
