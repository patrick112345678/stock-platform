# 台股：FinMind（日線 TaiwanStockPrice、基本面 PER/PBR/EPS、股名 TaiwanStockInfo）
# https://api.finmindtrade.com
FINMIND_API_TOKEN=

# TWSE OpenAPI：預設關閉；僅備援用，設為 true 才會發 HTTP
ENABLE_TWSE_OPENAPI=false

# 台股基本面：stock_fundamentals 表快取；TTL 內不重打 FinMind（小時）
FUNDAMENTAL_TTL_HOURS=24
# 每日背景同步（true/false）
ENABLE_FUNDAMENTAL_DAILY_SYNC=true
# 每日同步最多檔數
FUNDAMENTAL_DAILY_SYNC_MAX=500

# 行情快取：price_cache / chart_cache TTL（分鐘）；scanner_cache 自選股命中時亦用 SCANNER_CACHE_TTL_MINUTES
MARKET_PRICE_TTL_MINUTES=10
MARKET_CHART_TTL_MINUTES=10
SCANNER_CACHE_TTL_MINUTES=10
